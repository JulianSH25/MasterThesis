    "import os\n",
    "import re\n",
    "import ast\n",
    "\n",
    "def extract_energies(text):\n",
    "    pattern = r\"Energies observed during COBYLA optimization:\\s*(\\[[^\\]]*\\])\"\n",
    "    match = re.search(pattern, text)\n",
    "    if not match:\n",
    "        return None\n",
    "    try:\n",
    "        return ast.literal_eval(match.group(1))\n",
    "    except Exception:\n",
    "        return None\n",
    "\n",
    "def analyze_logs(folder, top_n=5, threshold=0.1):\n",
    "    diffs = []  # (diff, filename)\n",
    "\n",
    "    total = 0\n",
    "    above_threshold = 0\n",
    "\n",
    "    for fname in os.listdir(folder):\n",
    "        if not fname.endswith(\".log\"):\n",
    "            continue\n",
    "\n",
    "        path = os.path.join(folder, fname)\n",
    "        with open(path, \"r\") as f:\n",
    "            content = f.read()\n",
    "\n",
    "        energies = extract_energies(content)\n",
    "        if not energies or len(energies) < 2:\n",
    "            continue\n",
    "\n",
    "        total += 1\n",
    "        diff = abs(energies[0] - energies[-1])  # improvement\n",
    "\n",
    "        if diff > threshold:\n",
    "            above_threshold += 1\n",
    "\n",
    "        diffs.append((diff, fname))\n",
    "\n",
    "    # sort descending by improvement\n",
    "    diffs.sort(reverse=True, key=lambda x: x[0])\n",
    "\n",
    "    print(f\"\\nTop {top_n} improvements:\")\n",
    "    for d, fname in diffs[:top_n]:\n",
    "        print(f\"{fname}: {d:.6f}\")\n",
    "\n",
    "    print(f\"\\nThreshold > {threshold}: {above_threshold}/{total}\")\n",
    "\n",
    "    return diffs\n",
    "\n",
    "\n",
    "# usage\n",
